{
	"name": "blendcalc",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"overrides": {
		"esbuild": "^0.28.1",
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	},
	"scripts": {
		"dev": "vite dev --host localhost --port 5173 --strictPort",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:auth": "node scripts/check_auth_config.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"audit:fdc-vitals": "node scripts/audit_fdc_vitals.mjs",
		"import:nutrition:cnf": "node scripts/import_cnf_2026.mjs",
		"import:nutrition:cofid": "node scripts/import_cofid_2021.mjs",
		"audit:fdc-allergens": "node scripts/audit_fdc_allergen_fields.mjs",
		"audit:usda-branded-allergens": "node scripts/audit_usda_branded_allergen_fields.mjs",
		"audit:off-allergens": "node scripts/audit_openfoodfacts_allergen_fields.mjs",
		"report:source-quality": "node scripts/report_product_source_quality.mjs",
		"benchmark:source-quality": "node scripts/benchmark_product_sources.mjs",
		"seed:food-preferences": "node scripts/seed_food_preference_api_observations.mjs",
		"seed:food-categories": "node scripts/seed_custom_food_categories.mjs",
		"seed:food-categories:deep": "node scripts/seed_custom_food_categories.mjs --deep",
		"seed:food-categories:rebuild": "node scripts/seed_custom_food_categories.mjs --rebuild-mappings-only",
		"backfill:shared-product-categories": "node scripts/backfill_shared_product_categories.mjs",
		"generate:api-structures": "node scripts/generate_api_structures.mjs",
		"backfill:food-images": "node scripts/backfill_food_images.mjs",
		"backfill:product-names": "node scripts/backfill_product_names.mjs",
		"compare:fdc": "node scripts/compare_fdc_products.mjs",
		"discover:fdc-nutrients": "node scripts/discover_fdc_nutrients.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"kill:vite": "pkill -f \"node .*node_modules/.bin/vite dev\" 2>/dev/null || true",
		"free:dev-port": "pids=$(lsof -ti :5173 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi",
		"predev": "npm run kill:vite && npm run free:dev-port",
		"supabase": "supabase",
		"db:link": "supabase link --project-ref wbqsnipoiqjzppjuawpn",
		"db:new": "supabase migration new",
		"db:push": "supabase db push",
		"db:push:auto": "node scripts/push_supabase_db.mjs",
		"db:types": "mkdir -p src/lib/types && supabase gen types typescript --linked > src/lib/types/database.types.ts",
		"db:push:dry": "node scripts/push_supabase_db.mjs --dry-run",
		"db:lint": "supabase db lint --linked",
		"catalog:qa-seed": "node scripts/seed_catalog_submission.mjs seed",
		"catalog:qa-clean": "node scripts/seed_catalog_submission.mjs cleanup",
		"catalog:qa-image-seed": "node scripts/seed_image_moderation_submission.mjs seed",
		"catalog:qa-image-clean": "node scripts/seed_image_moderation_submission.mjs cleanup",
		"moderate": "node scripts/moderate_user.mjs",
		"seed:manual-entry-nutrients": "node scripts/seed_manual_entry_nutrients.mjs",
		"seed:product-reference-data": "node scripts/seed_product_reference_data.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.65.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^25.9.1",
		"@types/ws": "^8.18.1",
		"csv-parse": "^6.2.1",
		"jsdom": "^29.1.1",
		"read-excel-file": "^9.3.2",
		"sass": "^1.100.0",
		"supabase": "^2.109.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"@capacitor/barcode-scanner": "^3.0.2",
		"@capacitor/core": "^8.4.0",
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.108.1",
		"@vercel/speed-insights": "^2.0.0",
		"@zxing/browser": "^0.2.0",
		"@zxing/library": "^0.22.0",
		"bufferutil": "^4.1.0",
		"dotenv": "^17.4.2",
		"node-fetch": "^3.3.2",
		"tesseract.js": "^7.0.0",
		"utf-8-validate": "^6.0.6",
		"ws": "^8.21.0"
	}
}
