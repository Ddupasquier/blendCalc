{
	"name": "blendcalc",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"overrides": {
		"esbuild": "^0.28.1",
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	},
	"scripts": {
		"dev": "vite dev --host localhost --port 5173 --strictPort",
		"predev:test": "npm run kill:vite && npm run free:dev-port && npm run db:test:start",
		"dev:test": "vite dev --mode test --host localhost --port 5173 --strictPort",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:auth": "node scripts/operations/check_auth_config.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"import:nutrition:cnf": "node scripts/imports/import_cnf_2026.mjs",
		"import:nutrition:cofid": "node scripts/imports/import_cofid_2021.mjs",
		"audit:usda-branded-allergens": "node scripts/audits/audit_usda_branded_allergen_fields.mjs",
		"audit:off-allergens": "node scripts/audits/audit_openfoodfacts_allergen_fields.mjs",
		"report:source-quality": "node scripts/audits/report_product_source_quality.mjs",
		"benchmark:source-quality": "node scripts/audits/benchmark_product_sources.mjs",
		"seed:food-preferences": "node scripts/seeds/seed_food_preference_api_observations.mjs",
		"seed:food-categories": "node scripts/seeds/seed_custom_food_categories.mjs",
		"seed:food-categories:deep": "node scripts/seeds/seed_custom_food_categories.mjs --deep",
		"seed:food-categories:rebuild": "node scripts/seeds/seed_custom_food_categories.mjs --rebuild-mappings-only",
		"backfill:shared-product-categories": "node scripts/backfills/backfill_shared_product_categories.mjs",
		"generate:api-structures": "node scripts/generators/generate_api_structures.mjs",
  "backfill:food-images": "node scripts/backfills/backfill_food_images.mjs",
  "backfill:catalog-metadata": "node scripts/backfills/backfill_catalog_metadata.mjs",
  "backfill:product-names": "node scripts/backfills/backfill_product_names.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"kill:vite": "pkill -f \"node .*node_modules/.bin/vite dev\" 2>/dev/null || true",
		"free:dev-port": "pids=$(lsof -ti :5173 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi",
		"predev": "npm run kill:vite && npm run free:dev-port",
		"supabase": "supabase",
		"db:link": "supabase link --project-ref wbqsnipoiqjzppjuawpn",
		"db:new": "supabase migration new",
		"db:push": "supabase db push",
		"db:push:auto": "node scripts/operations/push_supabase_db.mjs",
		"db:types": "mkdir -p src/lib/types && supabase gen types typescript --linked > src/lib/types/database.types.ts",
		"db:push:dry": "node scripts/operations/push_supabase_db.mjs --dry-run",
		"db:lint": "supabase db lint --linked",
		"db:test:start": "node scripts/operations/manage_test_database.mjs start",
		"db:test:reset": "node scripts/operations/manage_test_database.mjs reset",
		"db:test:verify": "node scripts/operations/manage_test_database.mjs verify",
		"db:test:status": "node scripts/operations/manage_test_database.mjs status",
		"db:test:stop": "node scripts/operations/manage_test_database.mjs stop",
		"catalog:qa-seed": "node scripts/qa/seed_catalog_submission.mjs seed",
		"catalog:qa-clean": "node scripts/qa/seed_catalog_submission.mjs cleanup",
		"catalog:qa-image-seed": "node scripts/qa/seed_image_moderation_submission.mjs seed",
		"catalog:qa-image-clean": "node scripts/qa/seed_image_moderation_submission.mjs cleanup",
		"qa:deterministic": "node scripts/qa/run_deterministic_qa.mjs",
		"qa:no-serving-fixture": "node scripts/qa/check_no_serving_fixture.mjs",
		"moderate": "node scripts/operations/moderate_user.mjs",
		"seed:manual-entry-nutrients": "node scripts/seeds/seed_manual_entry_nutrients.mjs",
		"seed:product-reference-data": "node scripts/seeds/seed_product_reference_data.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.65.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^25.9.1",
		"@types/ws": "^8.18.1",
		"csv-parse": "^6.2.1",
		"jsdom": "^29.1.1",
		"read-excel-file": "^9.3.2",
		"sass": "^1.100.0",
		"supabase": "^2.109.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"@capacitor/barcode-scanner": "^3.0.2",
		"@capacitor/core": "^8.4.0",
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.108.1",
		"@vercel/speed-insights": "^2.0.0",
		"@zxing/browser": "^0.2.0",
		"@zxing/library": "^0.22.0",
		"bufferutil": "^4.1.0",
		"dotenv": "^17.4.2",
		"node-fetch": "^3.3.2",
		"tesseract.js": "^7.0.0",
		"utf-8-validate": "^6.0.6",
		"ws": "^8.21.0"
	}
}
