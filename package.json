{
	"name": "blendcalc",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"overrides": {
		"esbuild": "^0.28.1",
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	},
	"scripts": {
		"dev": "npm run dev:local",
		"predev:local": "npm run kill:vite && npm run free:dev-port && npm run version:check",
		"dev:local": "node scripts/operations/environment/run_application_environment.mjs local",
		"predev:test": "npm run free:test-port && npm run version:check",
		"dev:test": "node scripts/operations/environment/run_application_environment.mjs test",
		"predev:test:auth": "npm run predev:test",
		"dev:test:auth": "node scripts/operations/environment/run_application_environment.mjs test --auth",
		"predev:rehearsal": "npm run free:rehearsal-port && npm run version:check",
		"dev:rehearsal": "node scripts/operations/environment/run_application_environment.mjs rehearsal",
		"mobile:sync": "cap sync",
		"mobile:sync:ios": "cap sync ios",
		"mobile:sync:android": "cap sync android",
		"mobile:open:ios": "cap open ios",
		"mobile:open:android": "cap open android",
		"mobile:doctor": "cap doctor",
		"build:test:e2e": "node scripts/operations/quality/run_with_resource_limits.mjs vite build --mode test",
		"preview:test:e2e": "vite preview --mode test --host localhost --port 5174 --strictPort",
		"test:e2e:server": "npm run build:test:e2e && npm run preview:test:e2e",
		"prebuild": "npm run version:check",
		"build": "node scripts/operations/quality/run_with_resource_limits.mjs vite build",
		"postbuild": "npm run verify:vercel-routes",
		"prepreview": "npm run version:check",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run version:check",
		"check": "node scripts/operations/environment/run_test_command.mjs -- svelte-kit sync && node scripts/operations/environment/run_test_command.mjs -- svelte-check --tsconfig ./tsconfig.json",
		"lint": "npm run lint:code && npm run lint:styles",
		"lint:code": "eslint . --quiet --cache --cache-location .cache/eslint",
		"lint:code:all": "eslint . --cache --cache-location .cache/eslint",
		"lint:styles": "stylelint \"src/**/*.{scss,svelte}\" --cache --cache-location .cache/stylelint",
		"format": "prettier --write",
		"format:check": "node scripts/operations/quality/check_new_file_formatting.mjs",
		"format:check:all": "prettier --check .",
		"check:auth": "node scripts/operations/auth/check_auth_config.mjs",
		"auth:configure-hosted": "node scripts/operations/auth/configure_hosted_auth.mjs",
		"precheck:watch": "npm run version:check",
		"check:watch": "node scripts/operations/environment/run_test_command.mjs -- svelte-kit sync && node scripts/operations/environment/run_test_command.mjs -- svelte-check --tsconfig ./tsconfig.json --watch",
		"version:check": "node scripts/operations/releases/check_versions.mjs",
		"verify:vercel-routes": "node scripts/operations/releases/verify_vercel_routes.mjs",
		"version:bump": "node scripts/operations/releases/bump_app_version.mjs",
		"resources:check": "node scripts/operations/quality/check_resource_safety.mjs",
		"import:nutrition:cnf": "node scripts/imports/nutrition/import_cnf_2026.mjs",
		"import:nutrition:cofid": "node scripts/imports/nutrition/import_cofid_2021.mjs",
		"audit:blendCalcAPI-catalog": "node scripts/audits/catalog/audit_blendCalcAPI_catalog_readiness.mjs",
		"audit:blendCalcAPI-performance": "node scripts/audits/catalog/audit_blendCalcAPI_response_performance.mjs",
		"audit:blendCalcAPI-load": "node scripts/audits/catalog/audit_blendCalcAPI_read_load.mjs",
		"audit:blendCalcAPI-payloads": "node scripts/audits/catalog/audit_blendCalcAPI_payload_sizes.mjs",
		"report:source-quality": "node scripts/audits/food-sources/report_product_source_quality.mjs",
		"audit:off-nutrient-mappings": "node scripts/audits/food-sources/audit_open_food_facts_nutrient_mappings.mjs",
		"generate:api-structures": "node scripts/generators/api/generate_api_structures.mjs",
		"pretest": "npm run version:check",
		"test": "node scripts/operations/environment/run_test_command.mjs -- node scripts/operations/quality/run_with_resource_limits.mjs vitest run --reporter=dot",
		"test:node": "node scripts/operations/environment/run_test_command.mjs -- node scripts/operations/quality/run_with_resource_limits.mjs vitest run --project=node --reporter=dot",
		"test:dom": "npm run test:dom:fast && npm run test:dom:svelte-runtime",
		"test:dom:fast": "node scripts/operations/environment/run_test_command.mjs -- node scripts/operations/quality/run_with_resource_limits.mjs vitest run --project=dom --reporter=dot",
		"test:dom:svelte-runtime": "node scripts/operations/environment/run_test_command.mjs -- node scripts/operations/quality/run_with_resource_limits.mjs vitest run --project=dom-svelte-runtime --reporter=dot",
		"test:focused": "node scripts/operations/environment/run_test_command.mjs -- vitest run --reporter=dot",
		"test:affected": "node scripts/operations/environment/run_test_command.mjs -- node scripts/operations/quality/run_affected_tests.mjs unit",
		"pretest:watch": "npm run version:check",
		"test:watch": "node scripts/operations/environment/run_test_command.mjs -- vitest",
		"test:e2e:prepare": "npm run resources:check && npm run free:test-port && npm run version:check && npm run db:test:start",
		"test:e2e": "node scripts/operations/quality/run_browser_verification.mjs",
		"test:e2e:run": "PLAYWRIGHT_SKIP_WEB_SERVER=1 node scripts/operations/quality/run_with_resource_limits.mjs playwright test",
		"test:e2e:affected": "node scripts/operations/quality/run_affected_tests.mjs browser --prepare",
		"test:e2e:affected:run": "node scripts/operations/quality/run_affected_tests.mjs browser",
		"test:e2e:chromium": "node scripts/operations/quality/run_browser_verification.mjs --project=desktop-chromium --project=mobile-chromium",
		"test:e2e:chromium:run": "PLAYWRIGHT_SKIP_WEB_SERVER=1 node scripts/operations/quality/run_with_resource_limits.mjs playwright test --project=desktop-chromium --project=mobile-chromium",
		"test:e2e:compatibility": "node scripts/operations/quality/run_browser_verification.mjs --grep @compatibility",
		"test:e2e:nightly": "PLAYWRIGHT_EXHAUSTIVE_MATRIX=true node scripts/operations/quality/run_browser_verification.mjs",
		"test:e2e:session:start": "npm run test:e2e:prepare && npm run test:e2e:server",
		"test:e2e:headed": "node scripts/operations/quality/run_browser_verification.mjs --project=desktop-chromium --headed",
		"test:e2e:ui": "node scripts/operations/quality/run_browser_verification.mjs --ui",
		"test:e2e:update": "node scripts/operations/quality/run_browser_verification.mjs --project=desktop-chromium --project=mobile-chromium --update-snapshots",
		"test:e2e:install": "playwright install chromium firefox webkit",
		"verify:quick": "node scripts/operations/quality/run_verification_dashboard.mjs quick",
		"verify:feature": "node scripts/operations/quality/run_with_resource_limits.mjs node scripts/operations/quality/run_verification_dashboard.mjs feature",
		"verify:release": "node scripts/operations/quality/run_with_resource_limits.mjs node scripts/operations/quality/run_verification_dashboard.mjs release",
		"verify:promotion": "node scripts/operations/quality/verify_release_promotion.mjs",
		"verify:nightly": "node scripts/operations/quality/run_with_resource_limits.mjs node scripts/operations/quality/run_verification_dashboard.mjs nightly",
		"kill:vite": "pkill -f \"node .*node_modules/.bin/vite dev\" 2>/dev/null || true",
		"free:dev-port": "pids=$(lsof -ti :5173 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi",
		"free:test-port": "pids=$(lsof -ti :5174 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi",
		"free:rehearsal-port": "pids=$(lsof -ti :5175 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi",
		"supabase": "supabase",
		"db:link": "supabase link --project-ref wbqsnipoiqjzppjuawpn",
		"db:new": "supabase migration new",
		"db:push": "node scripts/operations/database/push_supabase_db.mjs",
		"db:push:auto": "node scripts/operations/database/push_supabase_db.mjs --yes",
		"db:types": "mkdir -p src/lib/types && supabase gen types typescript --linked > src/lib/types/database.types.ts",
		"db:push:dry": "node scripts/operations/database/push_supabase_db.mjs --dry-run",
		"db:lint": "supabase db lint --linked",
		"blendCalcAPI:db:start": "node scripts/operations/database/manage_blendcalc_api_local_database.mjs start",
		"blendCalcAPI:db:reset": "node scripts/operations/database/manage_blendcalc_api_local_database.mjs reset",
		"blendCalcAPI:db:test": "node scripts/operations/database/manage_blendcalc_api_local_database.mjs test",
		"blendCalcAPI:db:status": "node scripts/operations/database/manage_blendcalc_api_local_database.mjs status",
		"blendCalcAPI:db:stop": "node scripts/operations/database/manage_blendcalc_api_local_database.mjs stop",
		"blendCalcAPI:db:push": "node scripts/operations/database/push_blendcalc_api_db.mjs",
		"blendCalcAPI:db:push:auto": "node scripts/operations/database/push_blendcalc_api_db.mjs --yes",
		"blendCalcAPI:db:push:dry": "node scripts/operations/database/push_blendcalc_api_db.mjs --dry-run",
		"blendCalcAPI:db:types": "supabase gen types typescript --local --workdir infrastructure/blendCalcAPI | prettier --parser typescript > infrastructure/blendCalcAPI/supabase/database.types.ts",
		"recovery:blendCalcAPI": "node scripts/operations/recovery/run_blendcalc_api_recovery_drill.mjs",
		"db:local:start": "node scripts/operations/database/manage_local_database.mjs start",
		"db:local:status": "node scripts/operations/database/manage_local_database.mjs status",
		"db:local:stop": "node scripts/operations/database/manage_local_database.mjs stop",
		"db:rehearsal:prove-export-boundary": "node scripts/operations/rehearsal/prove_export_authorization_boundary.mjs",
		"db:rehearsal:prove-installed-boundary": "node scripts/operations/rehearsal/prove_installed_export_boundary.mjs",
		"db:rehearsal:refresh-local": "node scripts/operations/rehearsal/prove_installed_export_boundary.mjs --retain-local-baseline",
		"db:rehearsal:provision-source": "node scripts/operations/rehearsal/provision_production_source.mjs",
		"db:rehearsal:deprovision-source": "node scripts/operations/rehearsal/deprovision_production_source.mjs",
		"db:rehearsal:refresh": "node scripts/operations/rehearsal/refresh_production_baseline.mjs",
		"db:rehearsal:start": "rehearsal start",
		"db:rehearsal:reset": "rehearsal reset",
		"db:rehearsal:status": "rehearsal status",
		"db:rehearsal:stop": "rehearsal stop",
		"db:rehearsal:discard": "rehearsal discard",
		"db:rehearsal:candidates": "rehearsal candidates",
		"db:rehearsal:migrate": "rehearsal migrate",
		"db:rehearsal:verify": "rehearsal verify",
		"db:rehearsal:run": "rehearsal run",
		"db:rehearsal:verify-local-history": "node scripts/operations/rehearsal/verify_local_migration_history.mjs",
		"rehearsal": "rehearsal",
		"rehearsal:app:prove": "node scripts/operations/rehearsal/prove_rehearsal_application.mjs",
		"rehearsal:sanitization:generate": "node scripts/generators/rehearsal/generate_sanitization_manifest.mjs --write",
		"rehearsal:sanitization:check": "node scripts/generators/rehearsal/generate_sanitization_manifest.mjs --check",
		"rehearsal:export-migration:generate": "node scripts/generators/rehearsal/generate_export_boundary_migration.mjs --write",
		"rehearsal:export-migration:check": "node scripts/generators/rehearsal/generate_export_boundary_migration.mjs --check",
		"db:test:start": "node scripts/operations/database/manage_test_database.mjs start",
		"db:test:reset": "node scripts/operations/database/manage_test_database.mjs reset",
		"db:test:verify": "node scripts/operations/quality/run_with_resource_limits.mjs node scripts/operations/database/manage_test_database.mjs verify",
		"db:test:status": "node scripts/operations/database/manage_test_database.mjs status",
		"db:test:stop": "node scripts/operations/database/manage_test_database.mjs stop",
		"catalog:qa-seed": "node scripts/operations/environment/run_test_command.mjs -- node scripts/qa/catalog/seed_catalog_submission.mjs seed",
		"catalog:qa-clean": "node scripts/operations/environment/run_test_command.mjs -- node scripts/qa/catalog/seed_catalog_submission.mjs cleanup",
		"catalog:qa-image-seed": "node scripts/operations/environment/run_test_command.mjs -- node scripts/qa/catalog/seed_image_moderation_submission.mjs seed",
		"catalog:qa-image-clean": "node scripts/operations/environment/run_test_command.mjs -- node scripts/qa/catalog/seed_image_moderation_submission.mjs cleanup",
		"qa:deterministic": "node scripts/qa/database/run_deterministic_qa.mjs",
		"moderate": "node scripts/operations/users/moderate_user.mjs",
		"catalog:product:purge": "node scripts/operations/catalog/purge_catalog_product.mjs",
		"blendCalcAPI:publication": "node scripts/operations/blendCalcAPI/manage_blendCalcAPI_publication.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@capacitor/cli": "8.4.3",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@rehearsal-db/core": "0.1.0-beta.2",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.13.3",
		"@types/ws": "^8.18.1",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"csv-parse": "^7.0.1",
		"eslint": "^10.9.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^30.0.0",
		"postcss-html": "^2.0.0",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"read-excel-file": "^9.3.5",
		"sass": "^1.102.0",
		"stylelint": "^17.14.1",
		"stylelint-config-recommended-scss": "^17.0.1",
		"supabase": "^2.117.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.0.7",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.1",
		"@capacitor/barcode-scanner": "^3.1.2",
		"@capacitor/core": "^8.5.1",
		"@capacitor/ios": "^8.5.1",
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/png": "^3.1.1",
		"@jsquash/resize": "^2.1.1",
		"@jsquash/webp": "^1.5.0",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.111.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"@zxing/browser": "^0.2.1",
		"@zxing/library": "^0.23.0",
		"bufferutil": "^4.1.0",
		"dotenv": "^17.4.2",
		"node-fetch": "^3.3.2",
		"sharp": "^0.35.3",
		"tesseract.js": "^7.0.0",
		"utf-8-validate": "^6.0.6",
		"ws": "^8.21.1"
	},
	"allowScripts": {
		"@parcel/watcher@2.5.6": true,
		"bufferutil@4.1.0": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"fsevents@2.3.2": true,
		"tesseract.js@7.0.0": true,
		"utf-8-validate@6.0.6": true
	}
}
