{
	"name": "blendcalc",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"overrides": {
		"esbuild": "^0.28.1",
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	},
	"scripts": {
		"dev": "vite dev --host localhost --port 5173 --strictPort",
		"predev:test": "npm run free:test-port && npm run version:check && npm run db:test:start",
		"dev:test": "BLENDCALC_DATABASE_ENVIRONMENT=test vite dev --mode test --host localhost --port 5174 --strictPort",
		"dev:test:server": "BLENDCALC_DATABASE_ENVIRONMENT=test vite dev --mode test --host localhost --port 5174 --strictPort",
		"prebuild": "npm run version:check",
		"build": "vite build",
		"prepreview": "npm run version:check",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run version:check",
		"check": "BLENDCALC_DATABASE_ENVIRONMENT=test svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:auth": "node scripts/operations/auth/check_auth_config.mjs",
		"precheck:watch": "npm run version:check",
		"check:watch": "BLENDCALC_DATABASE_ENVIRONMENT=test svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"version:check": "node scripts/operations/releases/check_versions.mjs",
		"version:bump": "node scripts/operations/releases/bump_app_version.mjs",
		"import:nutrition:cnf": "node scripts/imports/nutrition/import_cnf_2026.mjs",
		"import:nutrition:cofid": "node scripts/imports/nutrition/import_cofid_2021.mjs",
		"audit:usda-branded-allergens": "node scripts/audits/food-sources/audit_usda_branded_allergen_fields.mjs",
		"audit:off-allergens": "node scripts/audits/food-sources/audit_openfoodfacts_allergen_fields.mjs",
		"audit:api-catalog": "node scripts/audits/catalog/audit_api_catalog_readiness.mjs",
		"report:source-quality": "node scripts/audits/food-sources/report_product_source_quality.mjs",
		"benchmark:source-quality": "node scripts/audits/food-sources/benchmark_product_sources.mjs",
		"seed:food-preferences": "node scripts/seeds/food-safety/seed_food_preference_api_observations.mjs",
		"seed:food-categories": "node scripts/seeds/catalog/seed_custom_food_categories.mjs",
		"seed:food-categories:deep": "node scripts/seeds/catalog/seed_custom_food_categories.mjs --deep",
		"seed:food-categories:rebuild": "node scripts/seeds/catalog/seed_custom_food_categories.mjs --rebuild-mappings-only",
		"backfill:shared-product-categories": "node scripts/backfills/catalog/backfill_shared_product_categories.mjs",
		"generate:api-structures": "node scripts/generators/api/generate_api_structures.mjs",
		"backfill:food-images": "node scripts/backfills/images/backfill_food_images.mjs",
		"pretest": "npm run version:check",
		"test": "BLENDCALC_DATABASE_ENVIRONMENT=test vitest run --reporter=dot",
		"pretest:watch": "npm run version:check",
		"test:watch": "BLENDCALC_DATABASE_ENVIRONMENT=test vitest",
		"test:e2e:prepare": "npm run free:test-port && npm run version:check && npm run db:test:start",
		"test:e2e": "npm run test:e2e:prepare && playwright test",
		"test:e2e:chromium": "npm run test:e2e:prepare && playwright test --project=desktop-chromium --project=mobile-chromium",
		"test:e2e:headed": "npm run test:e2e:prepare && playwright test --project=desktop-chromium --headed",
		"test:e2e:ui": "npm run test:e2e:prepare && playwright test --ui",
		"test:e2e:update": "npm run test:e2e:prepare && playwright test --project=desktop-chromium --project=mobile-chromium --update-snapshots",
		"test:e2e:install": "playwright install chromium firefox webkit",
		"kill:vite": "pkill -f \"node .*node_modules/.bin/vite dev\" 2>/dev/null || true",
		"free:dev-port": "pids=$(lsof -ti :5173 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi",
		"free:test-port": "pids=$(lsof -ti :5174 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi",
		"predev": "npm run kill:vite && npm run free:dev-port && npm run version:check",
		"supabase": "supabase",
		"db:link": "supabase link --project-ref wbqsnipoiqjzppjuawpn",
		"db:new": "supabase migration new",
		"db:push": "supabase db push",
		"db:push:auto": "node scripts/operations/database/push_supabase_db.mjs",
		"db:types": "mkdir -p src/lib/types && supabase gen types typescript --linked > src/lib/types/database.types.ts",
		"db:push:dry": "node scripts/operations/database/push_supabase_db.mjs --dry-run",
		"db:lint": "supabase db lint --linked",
		"db:test:start": "node scripts/operations/database/manage_test_database.mjs start",
		"db:test:reset": "node scripts/operations/database/manage_test_database.mjs reset",
		"db:test:verify": "node scripts/operations/database/manage_test_database.mjs verify",
		"db:test:status": "node scripts/operations/database/manage_test_database.mjs status",
		"db:test:stop": "node scripts/operations/database/manage_test_database.mjs stop",
		"catalog:qa-seed": "BLENDCALC_DATABASE_ENVIRONMENT=test node scripts/qa/catalog/seed_catalog_submission.mjs seed",
		"catalog:qa-clean": "BLENDCALC_DATABASE_ENVIRONMENT=test node scripts/qa/catalog/seed_catalog_submission.mjs cleanup",
		"catalog:qa-image-seed": "BLENDCALC_DATABASE_ENVIRONMENT=test node scripts/qa/catalog/seed_image_moderation_submission.mjs seed",
		"catalog:qa-image-clean": "BLENDCALC_DATABASE_ENVIRONMENT=test node scripts/qa/catalog/seed_image_moderation_submission.mjs cleanup",
		"qa:deterministic": "node scripts/qa/database/run_deterministic_qa.mjs",
		"moderate": "node scripts/operations/users/moderate_user.mjs",
		"seed:manual-entry-nutrients": "node scripts/seeds/nutrition/seed_manual_entry_nutrients.mjs",
		"seed:product-reference-data": "node scripts/seeds/catalog/seed_product_reference_data.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.13.3",
		"@types/ws": "^8.18.1",
		"csv-parse": "^7.0.1",
		"jsdom": "^30.0.0",
		"read-excel-file": "^9.3.5",
		"sass": "^1.102.0",
		"supabase": "^2.110.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.7",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@capacitor/barcode-scanner": "^3.1.0",
		"@capacitor/core": "^8.4.2",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.111.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"@zxing/browser": "^0.2.1",
		"@zxing/library": "^0.23.0",
		"bufferutil": "^4.1.0",
		"dotenv": "^17.4.2",
		"node-fetch": "^3.3.2",
		"sharp": "^0.35.3",
		"tesseract.js": "^7.0.0",
		"utf-8-validate": "^6.0.6",
		"ws": "^8.21.1"
	},
	"allowScripts": {
		"@parcel/watcher@2.5.6": true,
		"bufferutil@4.1.0": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"fsevents@2.3.2": true,
		"tesseract.js@7.0.0": true,
		"utf-8-validate@6.0.6": true
	}
}
