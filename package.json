{
	"name": "blendcalc",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"overrides": {
		"esbuild": "^0.28.1",
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	},
	"scripts": {
		"dev": "vite dev --host localhost --port 5173 --strictPort",
		"predev:test": "npm run free:test-port && npm run version:check && npm run db:test:start",
		"dev:test": "BLENDCALC_DATABASE_ENVIRONMENT=test vite dev --mode test --host localhost --port 5174 --strictPort",
		"build:test:e2e": "BLENDCALC_DATABASE_ENVIRONMENT=test vite build --mode test",
		"preview:test:e2e": "BLENDCALC_DATABASE_ENVIRONMENT=test vite preview --mode test --host localhost --port 5174 --strictPort",
		"test:e2e:server": "npm run build:test:e2e && npm run preview:test:e2e",
		"prebuild": "npm run version:check",
		"build": "vite build",
		"prepreview": "npm run version:check",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run version:check",
		"check": "PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_compile_only BLENDCALC_DATABASE_ENVIRONMENT=test svelte-kit sync && PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_compile_only BLENDCALC_DATABASE_ENVIRONMENT=test svelte-check --tsconfig ./tsconfig.json",
		"lint": "npm run lint:code && npm run lint:styles",
		"lint:code": "eslint . --quiet --cache --cache-location .cache/eslint",
		"lint:code:all": "eslint . --cache --cache-location .cache/eslint",
		"lint:styles": "stylelint \"src/**/*.{scss,svelte}\" --cache --cache-location .cache/stylelint",
		"format": "prettier --write",
		"format:check": "node scripts/operations/quality/check_new_file_formatting.mjs",
		"format:check:all": "prettier --check .",
		"check:auth": "node scripts/operations/auth/check_auth_config.mjs",
		"auth:configure-hosted": "node scripts/operations/auth/configure_hosted_auth.mjs",
		"precheck:watch": "npm run version:check",
		"check:watch": "PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_compile_only BLENDCALC_DATABASE_ENVIRONMENT=test svelte-kit sync && PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_compile_only BLENDCALC_DATABASE_ENVIRONMENT=test svelte-check --tsconfig ./tsconfig.json --watch",
		"version:check": "node scripts/operations/releases/check_versions.mjs",
		"version:bump": "node scripts/operations/releases/bump_app_version.mjs",
		"import:nutrition:cnf": "node scripts/imports/nutrition/import_cnf_2026.mjs",
		"import:nutrition:cofid": "node scripts/imports/nutrition/import_cofid_2021.mjs",
		"audit:blendCalcAPI-catalog": "node scripts/audits/catalog/audit_blendCalcAPI_catalog_readiness.mjs",
		"audit:blendCalcAPI-performance": "node scripts/audits/catalog/audit_blendCalcAPI_response_performance.mjs",
		"audit:blendCalcAPI-load": "node scripts/audits/catalog/audit_blendCalcAPI_read_load.mjs",
		"audit:blendCalcAPI-payloads": "node scripts/audits/catalog/audit_blendCalcAPI_payload_sizes.mjs",
		"report:source-quality": "node scripts/audits/food-sources/report_product_source_quality.mjs",
		"generate:api-structures": "node scripts/generators/api/generate_api_structures.mjs",
		"pretest": "npm run version:check",
		"test": "BLENDCALC_DATABASE_ENVIRONMENT=test npm run test:node && npm run test:dom",
		"test:node": "BLENDCALC_DATABASE_ENVIRONMENT=test vitest run --project=node --reporter=dot",
		"test:dom": "npm run test:dom:fast && npm run test:dom:svelte-runtime",
		"test:dom:fast": "BLENDCALC_DATABASE_ENVIRONMENT=test vitest run --project=dom --reporter=dot",
		"test:dom:svelte-runtime": "BLENDCALC_DATABASE_ENVIRONMENT=test vitest run --project=dom-svelte-runtime --reporter=dot",
		"test:focused": "BLENDCALC_DATABASE_ENVIRONMENT=test vitest run --reporter=dot",
		"test:affected": "BLENDCALC_DATABASE_ENVIRONMENT=test node scripts/operations/quality/run_affected_tests.mjs unit",
		"pretest:watch": "npm run version:check",
		"test:watch": "BLENDCALC_DATABASE_ENVIRONMENT=test vitest",
		"test:e2e:prepare": "npm run free:test-port && npm run version:check && npm run db:test:start",
		"test:e2e": "npm run test:e2e:prepare && playwright test",
		"test:e2e:run": "PLAYWRIGHT_SKIP_WEB_SERVER=1 playwright test",
		"test:e2e:affected": "node scripts/operations/quality/run_affected_tests.mjs browser --prepare",
		"test:e2e:affected:run": "node scripts/operations/quality/run_affected_tests.mjs browser",
		"test:e2e:chromium": "npm run test:e2e:prepare && playwright test --project=desktop-chromium --project=mobile-chromium",
		"test:e2e:chromium:run": "PLAYWRIGHT_SKIP_WEB_SERVER=1 playwright test --project=desktop-chromium --project=mobile-chromium",
		"test:e2e:compatibility": "npm run test:e2e:prepare && playwright test --grep @compatibility",
		"test:e2e:nightly": "npm run test:e2e:prepare && PLAYWRIGHT_EXHAUSTIVE_MATRIX=true playwright test",
		"test:e2e:session:start": "npm run test:e2e:prepare && npm run test:e2e:server",
		"test:e2e:headed": "npm run test:e2e:prepare && playwright test --project=desktop-chromium --headed",
		"test:e2e:ui": "npm run test:e2e:prepare && playwright test --ui",
		"test:e2e:update": "npm run test:e2e:prepare && playwright test --project=desktop-chromium --project=mobile-chromium --update-snapshots",
		"test:e2e:install": "playwright install chromium firefox webkit",
		"verify:quick": "node scripts/operations/quality/run_verification_dashboard.mjs quick",
		"verify:feature": "node scripts/operations/quality/run_verification_dashboard.mjs feature",
		"verify:release": "node scripts/operations/quality/run_verification_dashboard.mjs release",
		"verify:nightly": "node scripts/operations/quality/run_verification_dashboard.mjs nightly",
		"kill:vite": "pkill -f \"node .*node_modules/.bin/vite dev\" 2>/dev/null || true",
		"free:dev-port": "pids=$(lsof -ti :5173 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi",
		"free:test-port": "pids=$(lsof -ti :5174 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi",
		"predev": "npm run kill:vite && npm run free:dev-port && npm run version:check",
		"supabase": "supabase",
		"db:link": "supabase link --project-ref wbqsnipoiqjzppjuawpn",
		"db:new": "supabase migration new",
		"db:push": "node scripts/operations/database/push_supabase_db.mjs",
		"db:push:auto": "node scripts/operations/database/push_supabase_db.mjs --yes",
		"db:types": "mkdir -p src/lib/types && supabase gen types typescript --linked > src/lib/types/database.types.ts",
		"db:push:dry": "node scripts/operations/database/push_supabase_db.mjs --dry-run",
		"db:lint": "supabase db lint --linked",
		"blendCalcAPI:db:start": "supabase start --workdir infrastructure/blendCalcAPI",
		"blendCalcAPI:db:reset": "supabase db reset --local --workdir infrastructure/blendCalcAPI",
		"blendCalcAPI:db:test": "supabase test db --local --workdir infrastructure/blendCalcAPI",
		"blendCalcAPI:db:stop": "supabase stop --workdir infrastructure/blendCalcAPI",
		"blendCalcAPI:db:push": "node scripts/operations/database/push_blendcalc_api_db.mjs",
		"blendCalcAPI:db:push:auto": "node scripts/operations/database/push_blendcalc_api_db.mjs --yes",
		"blendCalcAPI:db:push:dry": "node scripts/operations/database/push_blendcalc_api_db.mjs --dry-run",
		"blendCalcAPI:db:types": "supabase gen types typescript --local --workdir infrastructure/blendCalcAPI | prettier --parser typescript > infrastructure/blendCalcAPI/supabase/database.types.ts",
		"db:test:start": "node scripts/operations/database/manage_test_database.mjs start",
		"db:test:reset": "node scripts/operations/database/manage_test_database.mjs reset",
		"db:test:verify": "node scripts/operations/database/manage_test_database.mjs verify",
		"db:test:status": "node scripts/operations/database/manage_test_database.mjs status",
		"db:test:stop": "node scripts/operations/database/manage_test_database.mjs stop",
		"catalog:qa-seed": "BLENDCALC_DATABASE_ENVIRONMENT=test node scripts/qa/catalog/seed_catalog_submission.mjs seed",
		"catalog:qa-clean": "BLENDCALC_DATABASE_ENVIRONMENT=test node scripts/qa/catalog/seed_catalog_submission.mjs cleanup",
		"catalog:qa-image-seed": "BLENDCALC_DATABASE_ENVIRONMENT=test node scripts/qa/catalog/seed_image_moderation_submission.mjs seed",
		"catalog:qa-image-clean": "BLENDCALC_DATABASE_ENVIRONMENT=test node scripts/qa/catalog/seed_image_moderation_submission.mjs cleanup",
		"qa:deterministic": "node scripts/qa/database/run_deterministic_qa.mjs",
		"moderate": "node scripts/operations/users/moderate_user.mjs",
		"blendCalcAPI:publication": "node scripts/operations/blendCalcAPI/manage_blendCalcAPI_publication.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.13.3",
		"@types/ws": "^8.18.1",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"csv-parse": "^7.0.1",
		"eslint": "^10.9.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^30.0.0",
		"postcss-html": "^2.0.0",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"read-excel-file": "^9.3.5",
		"sass": "^1.102.0",
		"stylelint": "^17.14.1",
		"stylelint-config-recommended-scss": "^17.0.1",
		"supabase": "^2.116.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.0.7",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@capacitor/barcode-scanner": "^3.1.0",
		"@capacitor/core": "^8.4.2",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.111.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"@zxing/browser": "^0.2.1",
		"@zxing/library": "^0.23.0",
		"bufferutil": "^4.1.0",
		"dotenv": "^17.4.2",
		"node-fetch": "^3.3.2",
		"sharp": "^0.35.3",
		"tesseract.js": "^7.0.0",
		"utf-8-validate": "^6.0.6",
		"ws": "^8.21.1"
	},
	"allowScripts": {
		"@parcel/watcher@2.5.6": true,
		"bufferutil@4.1.0": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"fsevents@2.3.2": true,
		"tesseract.js@7.0.0": true,
		"utf-8-validate@6.0.6": true
	}
}
