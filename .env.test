PUBLIC_SITE_URL=http://localhost:5174
PUBLIC_TURNSTILE_SITE_KEY=
BLENDCALC_RUNTIME_ENVIRONMENT=test
BLENDCALC_API_READ_MODE=isolated

# Safe, non-production placeholders keep isolated unit/component tests hermetic.
# Browser/database suites replace these with the local Supabase values generated
# in `.env.test.local` by `npm run db:test -- start`.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=blendcalc-local-test-publishable-key
