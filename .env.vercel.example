# Vercel application environment inventory.
# Configure values in Vercel; local pulls belong in ignored `.env.vercel.*.local` files.

# Browser-safe application configuration.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SITE_URL=
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only application and provider credentials.
SUPABASE_SERVICE_ROLE_KEY=
BLENDCALC_API_SUPABASE_URL=
BLENDCALC_API_SUPABASE_SERVICE_ROLE_KEY=
BLENDCALC_API_READ_MODE=source
FDC_API_KEY=
COLA_CLOUD_API_KEY=
FDA_RECALL_PROXY_SECRET=

# Optional moderation email delivery.
RESEND_API_KEY=
MODERATION_EMAIL_FROM="blendCalc <moderation@updates.example.com>"
MODERATION_SUPPORT_EMAIL=support@example.com

# Optional aggregate Vercel analytics synchronization.
VERCEL_ANALYTICS_ACCESS_TOKEN=
VERCEL_TEAM_ID=
CRON_SECRET=
VERCEL_ANALYTICS_SYNC_LOOKBACK_DAYS=3
