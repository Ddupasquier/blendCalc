# Custom Supabase Edge Function secrets.
# Copy to `supabase/functions/.env.local` for local function execution.
# Supabase supplies its own URL and service credentials in deployed functions.

# Catalog-monitor invocation and provider access.
CATALOG_MONITOR_CRON_SECRET=
USDA_API_KEY=
OPENFDA_API_KEY=

# Protected app-server recall relay.
FDA_RECALL_PROXY_URL=
FDA_RECALL_PROXY_SECRET=
FDA_RECALL_PROXY_PROTECTION_BYPASS_SECRET=
