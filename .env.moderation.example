# Local-only server/admin environment.
# Copy this file to `.env.moderation.local`.
# `.env.moderation.local` is ignored by git and must never be committed.

# Supabase project URL, same value as PUBLIC_SUPABASE_URL in `.env`.
PUBLIC_SUPABASE_URL=

# Project ref, visible in Supabase Project Settings → General.
SUPABASE_PROJECT_ID=

# Server-only Supabase service role key.
# Never expose this in browser code or PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Remote Postgres database password for Supabase CLI migrations.
# This is not your Supabase login password and not an API key.
# Leave blank until you reset/copy the database password.
SUPABASE_DB_PASSWORD=
