# Privileged local operations environment.
# Copy to `.env.moderation.local`; never commit populated values.

# Linked Supabase project identity and credentials.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Personal Supabase CLI token used only by hosted security and management commands.
SUPABASE_ACCESS_TOKEN=

# One-operation hosted Auth configuration inputs. Keep these only in the ignored
# `.env.moderation.local`; the configuration command never prints their values.
SUPABASE_AUTH_TURNSTILE_SECRET=
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=
SUPABASE_AUTH_SMTP_HOST=
SUPABASE_AUTH_SMTP_PORT=
SUPABASE_AUTH_SMTP_USER=
SUPABASE_AUTH_SMTP_PASS=
SUPABASE_AUTH_SMTP_SENDER_NAME=

# Provider keys used by privileged audits, imports, seeds, and backfills.
FDC_API_KEY=
COLA_CLOUD_API_KEY=
