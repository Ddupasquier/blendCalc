# FoodData Central API key
# Get your free API key at: https://fdc.nal.usda.gov/api-guide.html
VITE_FDC_API_KEY=

# Optional server-only U.S. alcohol-label lookup. Never prefix with PUBLIC_ or VITE_.
# Create and rotate keys at https://app.colacloud.us/.
COLA_CLOUD_API_KEY=

# Supabase public browser keys
# Safe to expose in the client. Security comes from Supabase Auth + RLS policies.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical production origin used for authentication callbacks. Vercel previews
# use VERCEL_URL/VERCEL_BRANCH_URL system variables and remain on their own host.
# Local development can leave this empty and will use http://localhost:5173.
PUBLIC_SITE_URL=

# Public Cloudflare Turnstile site key used by the Auth screen. Leave empty until
# the matching secret is configured in hosted Supabase Auth.
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Supabase admin key. Never prefix this with PUBLIC_ or expose it to browser code.
# Required in Vercel Production for the protected /moderation route. Do not add it to
# untrusted Preview deployments. For local CLI use, place it in
# .env.moderation.local instead of the normal browser-development environment file.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only transactional email configuration for moderation notices.
# Verify the sending domain with Resend before using it in production.
RESEND_API_KEY=
MODERATION_EMAIL_FROM="blendCalc <moderation@updates.example.com>"
MODERATION_SUPPORT_EMAIL=support@example.com

# Server-only Vercel Web Analytics synchronization.
# Vercel provides VERCEL_PROJECT_ID automatically when System Environment Variables
# are enabled. Set the remaining values in Vercel Production only.
VERCEL_ANALYTICS_ACCESS_TOKEN=
VERCEL_TEAM_ID=
CRON_SECRET=
VERCEL_ANALYTICS_SYNC_LOOKBACK_DAYS=3
