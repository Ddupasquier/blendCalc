# Local SvelteKit application environment.
# Copy to `.env`; never commit populated values.

# Browser-safe Supabase configuration.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local canonical origin. Leave empty to use http://localhost:5173.
PUBLIC_SITE_URL=

# Optional browser-safe Auth bot-protection site key.
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only provider credentials.
FDC_API_KEY=
COLA_CLOUD_API_KEY=

# Server-only Supabase access used by protected local server routes.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only isolated blendCalcAPI publication reads and synchronization.
BLENDCALC_API_SUPABASE_URL=
BLENDCALC_API_SUPABASE_SERVICE_ROLE_KEY=
BLENDCALC_API_READ_MODE=source
CRON_SECRET=

# Shared with the protected FDA recall relay route when testing it locally.
FDA_RECALL_PROXY_SECRET=

# Optional server-only moderation email delivery.
RESEND_API_KEY=
MODERATION_EMAIL_FROM="blendCalc <moderation@updates.example.com>"
MODERATION_SUPPORT_EMAIL=support@example.com
