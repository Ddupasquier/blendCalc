# Optional local-only SvelteKit overrides. `npm run dev` derives database credentials
# from the local stacks and never passes hosted or provider credentials through.
BLENDCALC_RUNTIME_ENVIRONMENT=local
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_TURNSTILE_SITE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BLENDCALC_API_SUPABASE_URL=http://127.0.0.1:55321
BLENDCALC_API_SUPABASE_SERVICE_ROLE_KEY=
BLENDCALC_API_READ_MODE=isolated
