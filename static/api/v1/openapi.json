{
  "openapi": "3.1.0",
  "info": {
    "title": "blendCalc Catalog API",
    "version": "1.0.0",
    "x-blendcalc-status": "internal",
    "x-blendcalc-access": "internal-authenticated",
    "x-blendcalc-public-release": "blocked-pending-professional-terms-review",
    "description": "Read-only internal preview of approved blendCalc catalog data. This contract never performs live provider lookups and never returns private foods or moderation evidence."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "cookieAuth": [] }],
  "paths": {
    "/api/v1/products/{barcode}": {
      "get": {
        "summary": "Get an approved product by GTIN",
        "operationId": "getProductByBarcode",
        "parameters": [{
          "name": "barcode",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "pattern": "^[0-9]{14}$" }
        }],
        "responses": {
          "200": {
            "description": "Approved catalog product",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/UnexpectedError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/v1/products/{barcode}/revisions": {
      "get": {
        "summary": "List evidence-backed revisions for an approved product",
        "operationId": "listProductRevisions",
        "parameters": [
          {
            "name": "barcode",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[0-9]{14}$" }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable revision metadata and supported field changes",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductRevisionListResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/UnexpectedError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/v1/foods/search": {
      "get": {
        "summary": "Search approved catalog products",
        "operationId": "searchFoods",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 2, "maxLength": 120 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 15 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked approved catalog products",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductListResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/UnexpectedError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "summary": "List enabled canonical food categories",
        "operationId": "listCategories",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Enabled canonical categories",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoryListResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/UnexpectedError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sb-wbqsnipoiqjzppjuawpn-auth-token",
        "description": "The existing blendCalc Supabase browser session. The cookie may be split into numbered chunks by the Supabase client. Public API keys are intentionally not available yet."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Unauthorized": {
        "description": "A signed-in blendCalc account is required",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Forbidden": {
        "description": "The signed-in account cannot access the requested resource",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "No approved catalog record matched",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "MethodNotAllowed": {
        "description": "The resource does not support the request method",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "RateLimited": {
        "description": "The request rate limit was reached",
        "headers": {
          "Retry-After": { "schema": { "type": "integer", "minimum": 0 } },
          "X-RateLimit-Remaining": { "schema": { "type": "integer", "minimum": 0 } }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "UnexpectedError": {
        "description": "The request could not be completed safely",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Unavailable": {
        "description": "The canonical catalog could not be read",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    },
    "schemas": {
      "Source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "reference", "confidence"],
        "properties": {
          "source": { "type": "string" },
          "reference": { "type": ["string", "null"] },
          "confidence": { "type": ["string", "null"] }
        }
      },
      "FieldSource": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "reference", "confidence", "observationId", "observedAt", "verificationMethod", "reviewState"],
        "properties": {
          "source": { "type": "string" },
          "reference": { "type": ["string", "null"] },
          "confidence": { "type": ["string", "null"] },
          "observationId": { "type": "string", "format": "uuid" },
          "observedAt": { "type": "string", "format": "date-time" },
          "verificationMethod": {
            "type": ["string", "null"],
            "enum": ["exact-barcode", "package-label", "corroborated-sources", "moderator-reviewed", null]
          },
          "reviewState": {
            "type": "string",
            "enum": ["accepted", "moderator-reviewed"]
          }
        }
      },
      "SourceAttribution": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "displayName", "sourceUrl", "licenseName", "licenseUrl", "attribution", "redistributionPolicyReviewedAt", "dataset"],
        "properties": {
          "source": { "type": "string" },
          "displayName": { "type": "string" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "licenseName": { "type": "string" },
          "licenseUrl": { "type": "string", "format": "uri" },
          "attribution": { "type": "string" },
          "redistributionPolicyReviewedAt": { "type": "string", "format": "date-time" },
          "dataset": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "name", "version", "importedAt"],
                "properties": {
                  "key": { "type": "string" },
                  "name": { "type": "string" },
                  "version": { "type": "string" },
                  "importedAt": { "type": "string", "format": "date-time" }
                }
              }
            ]
          }
        }
      },
      "Category": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "slug", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "Nutrient": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "number", "unit", "amountPer100g", "valueStatus", "source", "quality"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "number": { "type": ["string", "null"] },
          "unit": { "type": "string" },
          "amountPer100g": { "type": ["number", "null"], "minimum": 0 },
          "valueStatus": { "type": "string", "enum": ["reported", "estimated", "derived", "missing", "unknown"] },
          "source": { "oneOf": [{ "$ref": "#/components/schemas/Source" }, { "type": "null" }] },
          "quality": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceValueStatus", "standardError", "sourceNutrientKey", "sourceNutrientCode", "mappingStatus", "mappingMethod", "derivationMethod", "valueQualifier"],
            "properties": {
              "sourceValueStatus": { "type": "string", "enum": ["reported", "reported-zero", "estimated", "derived", "trace", "present-unquantified", "missing", "invalid", "unknown"] },
              "standardError": { "type": ["number", "null"], "minimum": 0 },
              "sourceNutrientKey": { "type": ["string", "null"] },
              "sourceNutrientCode": { "type": ["string", "null"] },
              "mappingStatus": { "type": "string", "enum": ["canonical", "unmapped", "excluded", "unknown"] },
              "mappingMethod": { "type": ["string", "null"] },
              "derivationMethod": { "type": ["string", "null"] },
              "valueQualifier": { "type": ["string", "null"], "enum": ["source-estimate", null] }
            }
          }
		}
      },
      "Serving": {
        "type": "object",
        "additionalProperties": false,
		"required": ["label", "grams", "quantity", "unit", "gramsPerUnit", "isPrimary", "measureType", "isHouseholdMeasure", "sourceMeasureKey", "origin", "gramWeightMethod", "calculationBasis", "source"],
        "properties": {
          "label": { "type": "string" },
          "grams": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "quantity": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "unit": { "type": ["string", "null"] },
		  "gramsPerUnit": { "type": ["number", "null"], "exclusiveMinimum": 0 },
		  "isPrimary": { "type": "boolean" },
		  "measureType": { "type": ["string", "null"] },
		  "isHouseholdMeasure": { "type": "boolean" },
		  "sourceMeasureKey": { "type": ["string", "null"] },
		  "origin": { "type": "string", "enum": ["package-label", "source-household-measure", "source-weight", "user-entered", "calculated-conversion", "unknown"] },
		  "gramWeightMethod": { "type": "string", "enum": ["source-reported", "exact-unit-conversion", "user-reported", "calculated-conversion", "unknown"] },
		  "calculationBasis": { "type": ["string", "null"] },
		  "source": { "oneOf": [{ "$ref": "#/components/schemas/Source" }, { "type": "null" }] }
        }
      },
      "Image": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "url", "thumbnailUrl", "sourceName", "sourceUrl", "license", "placement", "source", "approvedAt", "retrievedAt"],
        "properties": {
          "role": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "thumbnailUrl": { "type": ["string", "null"], "format": "uri" },
          "sourceName": { "type": "string" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "attribution"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "attribution": { "type": "string" }
            }
          },
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fitMode", "x", "y", "zoom", "rotationDegrees", "version"],
            "properties": {
              "fitMode": { "type": "string" },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "zoom": { "type": "number", "exclusiveMinimum": 0 },
              "rotationDegrees": { "type": "integer", "enum": [0, 90, 180, 270] },
              "version": { "type": "integer", "minimum": 1 }
            }
          },
          "source": { "$ref": "#/components/schemas/Source" },
          "approvedAt": { "type": ["string", "null"], "format": "date-time" },
          "retrievedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Warning": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "category", "type", "sourceType", "confidence", "sourceText"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "category": { "type": "string" },
          "type": { "type": "string" },
          "sourceType": { "type": "string" },
          "confidence": { "type": "string" },
          "sourceText": { "type": ["string", "null"] }
        }
      },
      "CompatibilityEvaluation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "status", "policyVersion", "profileApplied", "conflictCount", "coverage"],
        "properties": {
          "version": { "type": "integer", "const": 1 },
          "status": {
            "type": "string",
            "enum": ["conflict", "checked", "incomplete", "not_checked"]
          },
          "policyVersion": { "type": ["integer", "null"], "minimum": 1 },
          "profileApplied": { "type": "boolean" },
          "conflictCount": { "type": "integer", "minimum": 0 },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basis", "identity", "ingredients", "allergens", "traces", "policy"],
            "properties": {
              "basis": {
                "type": "string",
                "enum": ["generic-taxonomy", "packaged-label", "private-entry", "unknown-identity"]
              },
              "identity": {
                "type": "string",
                "enum": ["available", "missing", "not_required"]
              },
              "ingredients": {
                "type": "string",
                "enum": ["available", "missing", "not_required"]
              },
              "allergens": {
                "type": "string",
                "enum": ["available", "missing", "not_required"]
              },
              "traces": {
                "type": "string",
                "enum": ["available", "missing", "not_required"]
              },
              "policy": {
                "type": "string",
                "enum": ["available", "missing", "not_required"]
              }
            }
          }
        }
      },
      "CatalogMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority", "status", "verification", "redistributionPolicy", "sourceCount"],
        "properties": {
          "authority": { "type": "string", "const": "blendcalc-shared-catalog" },
          "status": { "type": "string", "const": "active" },
          "verification": { "type": "string" },
          "redistributionPolicy": { "type": "string", "const": "approved" },
          "sourceCount": { "type": "integer", "minimum": 1 }
        }
      },
      "Revision": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "number", "currentSince", "currentSinceBasis", "labelObservedAt", "updatedAt", "lastVerifiedAt"],
        "properties": {
          "id": { "type": ["string", "null"], "format": "uuid" },
          "number": { "type": ["integer", "null"], "minimum": 1 },
          "currentSince": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "The date blendCalc observed the current accepted label. It is not a manufacturer effective date unless currentSinceBasis explicitly says so."
          },
          "currentSinceBasis": {
            "type": ["string", "null"],
            "enum": ["manufacturer-effective", "blendcalc-observed", null]
          },
          "labelObservedAt": { "type": ["string", "null"], "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "lastVerifiedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "ProductRevisionChange": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "label", "changeType", "previousValue", "newValue", "severity"],
        "properties": {
          "field": {
            "oneOf": [
              {
                "type": "string",
                "enum": ["productName", "brandOwner", "category", "householdServing", "servingWeightGrams", "ingredients", "allergens", "traces"]
              },
              { "type": "string", "pattern": "^nutrient:[1-9][0-9]*$" }
            ]
          },
          "label": { "type": "string", "maxLength": 120 },
          "changeType": { "type": "string", "enum": ["added", "removed", "changed"] },
          "previousValue": { "$ref": "#/components/schemas/ProductRevisionValue" },
          "newValue": { "$ref": "#/components/schemas/ProductRevisionValue" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      },
      "ProductRevisionValue": {
        "oneOf": [
          { "type": "string", "maxLength": 20000 },
          { "type": "number", "minimum": 0 },
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "unit"],
            "properties": {
              "value": { "type": "number", "minimum": 0 },
              "unit": { "type": "string", "pattern": "^[A-Za-zµμ%]+$", "minLength": 1, "maxLength": 32 }
            }
          }
        ]
      },
      "ProductRevisionHistoryItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "number", "publishedAt", "labelObservedAt", "changes"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "number": { "type": "integer", "minimum": 1 },
          "publishedAt": { "type": "string", "format": "date-time" },
          "labelObservedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When blendCalc observed the accepted label; not an inferred manufacturer effective date."
          },
          "changes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProductRevisionChange" }
          }
        }
      },
      "StructuredIngredient": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "percent", "percentEstimate", "percentMin", "percentMax", "vegan", "vegetarian", "ingredients"],
        "properties": {
          "id": { "type": ["string", "null"] },
          "text": { "type": ["string", "null"] },
          "percent": { "type": ["number", "null"], "minimum": 0 },
          "percentEstimate": { "type": ["number", "null"], "minimum": 0 },
          "percentMin": { "type": ["number", "null"], "minimum": 0 },
          "percentMax": { "type": ["number", "null"], "minimum": 0 },
          "vegan": { "type": ["string", "null"] },
          "vegetarian": { "type": ["string", "null"] },
          "ingredients": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StructuredIngredient" }
          }
        }
      },
      "IngredientAnalysis": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ingredientTags", "analysisTags", "derivedTraceTags", "percentAnalysis", "percentEstimate", "percentKnown", "percentUnknown"],
        "properties": {
          "ingredientTags": { "type": "array", "items": { "type": "string" } },
          "analysisTags": { "type": "array", "items": { "type": "string" } },
          "derivedTraceTags": { "type": "array", "items": { "type": "string" } },
          "percentAnalysis": { "type": ["number", "null"], "minimum": 0 },
          "percentEstimate": { "type": ["number", "null"], "minimum": 0 },
          "percentKnown": { "type": ["number", "null"], "minimum": 0 },
          "percentUnknown": { "type": ["number", "null"], "minimum": 0 }
        }
      },
      "PackageQuantity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "amount", "unit"],
        "properties": {
          "label": { "type": ["string", "null"] },
          "amount": { "type": ["number", "null"], "minimum": 0 },
          "unit": { "type": ["string", "null"] }
        }
      },
      "SourceRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "languages", "marketCountries", "revision", "schemaVersion", "createdAt", "publishedAt", "availableAt", "modifiedAt", "updatedAt", "discontinuedAt", "completeness", "qualityTags", "qualityErrorTags", "qualityWarningTags", "obsolete", "obsoleteSince", "tagSources"],
        "properties": {
          "language": { "type": ["string", "null"] },
          "languages": { "type": "array", "items": { "type": "string" } },
          "marketCountries": { "type": "array", "items": { "type": "string" } },
          "revision": { "type": ["integer", "null"], "minimum": 0 },
          "schemaVersion": { "type": ["integer", "null"], "minimum": 0 },
          "createdAt": { "type": ["string", "null"], "format": "date-time" },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "availableAt": { "type": ["string", "null"], "format": "date-time" },
          "modifiedAt": { "type": ["string", "null"], "format": "date-time" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" },
          "discontinuedAt": { "type": ["string", "null"], "format": "date-time" },
          "completeness": { "type": ["number", "null"], "minimum": 0 },
          "qualityTags": { "type": "array", "items": { "type": "string" } },
          "qualityErrorTags": { "type": "array", "items": { "type": "string" } },
          "qualityWarningTags": { "type": "array", "items": { "type": "string" } },
          "obsolete": { "type": ["boolean", "null"] },
          "obsoleteSince": { "type": ["string", "null"] },
          "tagSources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "additives": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
              "allergens": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
              "categories": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
              "countries": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
              "ingredients": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
              "labels": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
              "languages": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
              "nutrients": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
              "packaging": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
              "traces": { "type": "array", "items": { "type": "string", "maxLength": 120 } }
            }
          }
        }
      },
      "PrecautionaryStatement": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text", "allergens", "languageCode", "sourceField", "sourceReference", "observationId", "revisionId", "labelObservedAt"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["may_contain", "shared_equipment", "shared_facility", "other_precautionary"]
          },
          "text": { "type": "string" },
          "allergens": { "type": "array", "items": { "type": "string" } },
          "languageCode": { "type": ["string", "null"] },
          "sourceField": { "type": "string" },
          "sourceReference": { "type": ["string", "null"] },
          "observationId": { "type": ["string", "null"], "format": "uuid" },
          "revisionId": { "type": ["string", "null"], "format": "uuid" },
          "labelObservedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "barcode", "name", "brand", "category", "ingredients", "packageQuantity", "sourceRecord", "nutrients", "servings", "images", "warnings", "compatibilityEvaluation", "sourceAttributions", "catalog", "fieldSources", "revision", "links"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "barcode": { "type": "string", "pattern": "^[0-9]{14}$" },
          "name": { "type": "string" },
          "brand": { "type": ["string", "null"] },
          "category": { "oneOf": [{ "$ref": "#/components/schemas/Category" }, { "type": "null" }] },
          "ingredients": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "items", "structured", "analysis", "additives", "allergens", "traces", "precautionaryStatements", "dietaryTags", "labels"],
            "properties": {
              "text": { "type": ["string", "null"] },
              "items": { "type": "array", "items": { "type": "string" } },
              "structured": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/StructuredIngredient" }
              },
              "analysis": {
                "oneOf": [
                  { "$ref": "#/components/schemas/IngredientAnalysis" },
                  { "type": "null" }
                ]
              },
              "additives": { "type": "array", "items": { "type": "string" } },
              "allergens": { "type": "array", "items": { "type": "string" } },
              "traces": { "type": "array", "items": { "type": "string" } },
              "precautionaryStatements": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/PrecautionaryStatement" }
              },
              "dietaryTags": { "type": "array", "items": { "type": "string" } },
              "labels": { "type": "array", "items": { "type": "string" } }
            }
          },
          "packageQuantity": {
            "oneOf": [
              { "$ref": "#/components/schemas/PackageQuantity" },
              { "type": "null" }
            ]
          },
          "sourceRecord": {
            "oneOf": [
              { "$ref": "#/components/schemas/SourceRecord" },
              { "type": "null" }
            ]
          },
          "nutrients": { "type": "array", "items": { "$ref": "#/components/schemas/Nutrient" } },
          "servings": { "type": "array", "items": { "$ref": "#/components/schemas/Serving" } },
          "images": { "type": "array", "items": { "$ref": "#/components/schemas/Image" } },
          "warnings": { "type": "array", "items": { "$ref": "#/components/schemas/Warning" } },
          "compatibilityEvaluation": { "$ref": "#/components/schemas/CompatibilityEvaluation" },
          "sourceAttributions": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/SourceAttribution" } },
          "catalog": { "$ref": "#/components/schemas/CatalogMetadata" },
          "fieldSources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "brand", "category", "ingredients", "structuredIngredients", "ingredientAnalysis", "additives", "allergens", "traces", "precautionaryStatements", "dietaryTags", "labels", "package", "sourceMetadata"],
            "properties": {
              "name": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "brand": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "category": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "ingredients": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "structuredIngredients": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "ingredientAnalysis": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "additives": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "allergens": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "traces": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "precautionaryStatements": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "dietaryTags": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "labels": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "package": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] },
              "sourceMetadata": { "oneOf": [{ "$ref": "#/components/schemas/FieldSource" }, { "type": "null" }] }
            }
          },
          "revision": { "$ref": "#/components/schemas/Revision" },
          "links": {
            "type": "object",
            "additionalProperties": false,
            "required": ["self"],
            "properties": { "self": { "type": "string" } }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "additionalProperties": false,
        "required": ["limit", "offset", "total", "hasMore", "nextOffset"],
        "properties": {
          "limit": { "type": "integer" },
          "offset": { "type": "integer" },
          "total": { "type": "integer" },
          "hasMore": { "type": "boolean" },
          "nextOffset": { "type": ["integer", "null"] }
        }
      },
      "ProductResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiVersion", "data"],
        "properties": {
          "apiVersion": { "type": "string", "const": "1.0" },
          "data": { "$ref": "#/components/schemas/Product" }
        }
      },
      "ProductListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiVersion", "data", "meta"],
        "properties": {
          "apiVersion": { "type": "string", "const": "1.0" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pagination"],
            "properties": { "pagination": { "$ref": "#/components/schemas/Pagination" } }
          }
        }
      },
      "ProductRevisionListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiVersion", "data", "meta"],
        "properties": {
          "apiVersion": { "type": "string", "const": "1.0" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProductRevisionHistoryItem" }
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pagination"],
            "properties": { "pagination": { "$ref": "#/components/schemas/Pagination" } }
          }
        }
      },
      "CategoryListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiVersion", "data", "meta"],
        "properties": {
          "apiVersion": { "type": "string", "const": "1.0" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pagination"],
            "properties": { "pagination": { "$ref": "#/components/schemas/Pagination" } }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiVersion", "error"],
        "properties": {
          "apiVersion": { "type": "string", "const": "1.0" },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "authentication_required",
                  "access_denied",
                  "invalid_request",
                  "invalid_barcode",
                  "invalid_query",
                  "invalid_pagination",
                  "product_not_found",
                  "resource_not_found",
                  "method_not_allowed",
                  "rate_limited",
                  "catalog_unavailable",
                  "service_unavailable",
                  "unexpected_error"
                ]
              },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
