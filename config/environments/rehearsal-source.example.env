# Dedicated least-privilege production Rehearsal readers. This is a key-name template
# only. Copy it to ignored `.env.rehearsal-source.local`, set mode 600, and never use a
# Supabase service-role key, dashboard access token, or ordinary application role.
# The PostgreSQL login must begin with `rehearsal_` and be fixed to one owner scope.
# The two short-lived Storage session tokens must issue
# `role=rehearsal_storage_reader` with that same owner UUID in protected app_metadata.
# Provisioning is a separate production-authorized operation.
REHEARSAL_SOURCE_DATABASE_URL=
REHEARSAL_SOURCE_STORAGE_URL=
REHEARSAL_SOURCE_STORAGE_PUBLISHABLE_KEY=
REHEARSAL_SOURCE_STORAGE_ACCESS_TOKEN=
REHEARSAL_SOURCE_STORAGE_REFRESH_TOKEN=
