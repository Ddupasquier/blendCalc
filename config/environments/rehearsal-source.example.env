# Server-only inputs for the reviewed package-owned source policies. Values belong
# in an owner-only environment manager or ignored `.env.rehearsal-source.local`.
# The CLI does not automatically load that file. Current policies bind only to the
# approved loopback copies; changing a source requires separate review/authorization.
# Use provider-supplied expiring read-only logins and a scoped Storage-reader token,
# never a service-role key, dashboard token or normal application credential.
# The reviewed source owner ID is not the Google login email and must stay private.
REHEARSAL_PRIMARY_SOURCE_URL=
REHEARSAL_PUBLICATION_SOURCE_URL=
REHEARSAL_APPROVED_OWNER_ID=
REHEARSAL_SOURCE_STORAGE_URL=
REHEARSAL_SOURCE_STORAGE_TOKEN=
